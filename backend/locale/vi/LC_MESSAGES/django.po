# Bổ sung bản dịch tiếng Việt cho thông báo có sẵn của Django REST framework
# mà gói DRF chưa dịch (LOCALE_PATHS được ưu tiên hơn locale của gói).
# Chuỗi do dự án tự viết có msgid tiếng Việt nên không cần mục ở đây.
# Sau khi sửa: msgfmt -o django.mo django.po (test common/tests/test_locale_catalogs.py
# kiểm tra .mo khớp .po).
msgid ""
msgstr ""
"Project-Id-Version: procv\n"
"Language: vi\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "\"{input}\" is not a valid choice."
msgstr "\"{input}\" không phải là lựa chọn hợp lệ."

msgid "\"{input}\" is not a valid path choice."
msgstr "\"{input}\" không phải là đường dẫn hợp lệ."

msgid "A server error occurred."
msgstr "Đã xảy ra lỗi máy chủ."

msgid "A valid integer is required."
msgstr "Vui lòng nhập một số nguyên hợp lệ."

msgid "A valid number is required."
msgstr "Vui lòng nhập một số hợp lệ."

msgid "Authentication credentials were not provided."
msgstr "Bạn cần đăng nhập để tiếp tục."

msgid "Datetime has wrong format. Use one of these formats instead: {format}."
msgstr "Ngày giờ sai định dạng. Hãy dùng một trong các định dạng: {format}."

msgid "Datetime value out of range."
msgstr "Giá trị ngày giờ nằm ngoài phạm vi cho phép."

msgid "Duration has wrong format. Use one of these formats instead: {format}."
msgstr "Khoảng thời gian sai định dạng. Hãy dùng một trong các định dạng: {format}."

msgid "Ensure that there are no more than {max_decimal_places} decimal places."
msgstr "Chỉ được có tối đa {max_decimal_places} chữ số thập phân."

msgid "Ensure that there are no more than {max_digits} digits in total."
msgstr "Chỉ được có tối đa {max_digits} chữ số."

msgid "Ensure that there are no more than {max_whole_digits} digits before the decimal point."
msgstr "Chỉ được có tối đa {max_whole_digits} chữ số trước dấu thập phân."

msgid "Ensure this field has at least {min_length} characters."
msgstr "Trường này cần ít nhất {min_length} ký tự."

msgid "Ensure this field has at least {min_length} elements."
msgstr "Trường này cần ít nhất {min_length} mục."

msgid "Ensure this field has no more than {max_length} characters."
msgstr "Trường này chỉ được tối đa {max_length} ký tự."

msgid "Ensure this field has no more than {max_length} elements."
msgstr "Trường này chỉ được tối đa {max_length} mục."

msgid "Ensure this filename has at most {max_length} characters (it has {length})."
msgstr "Tên tệp chỉ được tối đa {max_length} ký tự (hiện có {length})."

msgid "Ensure this value is greater than or equal to {min_value}."
msgstr "Giá trị phải lớn hơn hoặc bằng {min_value}."

msgid "Ensure this value is less than or equal to {max_value}."
msgstr "Giá trị phải nhỏ hơn hoặc bằng {max_value}."

msgid "Expected a date but got a datetime."
msgstr "Cần một ngày, không phải ngày giờ."

msgid "Expected a datetime but got a date."
msgstr "Cần ngày giờ, không phải chỉ ngày."

msgid "Expected a dictionary of items but got type \"{input_type}\"."
msgstr "Dữ liệu phải là một đối tượng, nhận được kiểu \"{input_type}\"."

msgid "Expected a list of items but got type \"{input_type}\"."
msgstr "Dữ liệu phải là một danh sách, nhận được kiểu \"{input_type}\"."

msgid "Expected available in {wait} second."
msgid_plural "Expected available in {wait} seconds."
msgstr[0] "Vui lòng thử lại sau {wait} giây."

msgid "Incorrect authentication credentials."
msgstr "Thông tin xác thực không đúng."

msgid "Incorrect type. Expected pk value, received {data_type}."
msgstr "Sai kiểu dữ liệu: cần mã định danh, nhận được {data_type}."

msgid "Invalid data. Expected a dictionary, but got {datatype}."
msgstr "Dữ liệu không hợp lệ: cần một đối tượng, nhận được {datatype}."

msgid "Invalid datetime for the timezone \"{timezone}\"."
msgstr "Ngày giờ không hợp lệ với múi giờ \"{timezone}\"."

msgid "Invalid input."
msgstr "Dữ liệu không hợp lệ."

msgid "Invalid page."
msgstr "Trang không hợp lệ."

msgid "Invalid pk \"{pk_value}\" - object does not exist."
msgstr "Không tìm thấy đối tượng có mã \"{pk_value}\"."

msgid "Invalid token."
msgstr "Mã xác thực không hợp lệ."

msgid "Invalid value."
msgstr "Giá trị không hợp lệ."

msgid "Malformed request."
msgstr "Yêu cầu sai định dạng."

msgid "Must be a valid UUID."
msgstr "Phải là một UUID hợp lệ."

msgid "Must be a valid boolean."
msgstr "Phải là giá trị đúng/sai hợp lệ."

msgid "No filename could be determined."
msgstr "Không xác định được tên tệp."

msgid "Not a valid string."
msgstr "Không phải chuỗi ký tự hợp lệ."

msgid "Object with {slug_name}={value} does not exist."
msgstr "Không tìm thấy đối tượng có {slug_name}={value}."

msgid "Permission denied."
msgstr "Bạn không có quyền thực hiện thao tác này."

msgid "Request was throttled."
msgstr "Bạn thao tác quá nhanh, vui lòng thử lại sau."

msgid "String value too large."
msgstr "Chuỗi ký tự quá dài."

msgid "The fields {field_names} must make a unique set."
msgstr "Bộ giá trị {field_names} đã tồn tại."

msgid "The submitted data was not a file. Check the encoding type on the form."
msgstr "Dữ liệu gửi lên không phải tệp. Hãy kiểm tra kiểu mã hóa của biểu mẫu."

msgid "This dictionary may not be empty."
msgstr "Đối tượng này không được để trống."

msgid "This field may not be null."
msgstr "Trường này không được để trống."

msgid "This field must be unique."
msgstr "Giá trị này đã tồn tại."

msgid "This field must be unique for the \"{date_field}\" date."
msgstr "Giá trị này đã tồn tại trong cùng ngày \"{date_field}\"."

msgid "This field must be unique for the \"{date_field}\" month."
msgstr "Giá trị này đã tồn tại trong cùng tháng \"{date_field}\"."

msgid "This field must be unique for the \"{date_field}\" year."
msgstr "Giá trị này đã tồn tại trong cùng năm \"{date_field}\"."

msgid "This selection may not be empty."
msgstr "Vui lòng chọn ít nhất một mục."

msgid "This value does not match the required pattern."
msgstr "Giá trị không đúng định dạng yêu cầu."

msgid "Time has wrong format. Use one of these formats instead: {format}."
msgstr "Giờ sai định dạng. Hãy dùng một trong các định dạng: {format}."

msgid "Unsupported media type \"{media_type}\" in request."
msgstr "Không hỗ trợ kiểu dữ liệu \"{media_type}\"."
