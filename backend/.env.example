# ProCV backend — mẫu cấu hình duy nhất. Sao chép thành backend/.env:
#   cp .env.example .env
# Đồng bộ lại sau khi mẫu thay đổi (giữ nguyên giá trị đang có):
#   python3 ../scripts/sync_local_env.py
#
# Quy ước:
# - Backend chỉ đọc backend/.env; process environment luôn được ưu tiên.
# - Giá trị trong mẫu là mặc định local an toàn, không chứa secret thật.
# - decouple KHÔNG cắt comment cuối dòng: "86400  # 24h" làm cast=int lỗi.
#   Comment luôn đặt ở dòng riêng.
# - Docker Compose tự override DB_HOST/REDIS_URL/... sang service nội bộ.

# ─────────────────────────────────────────────────────────────
# Django
# ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=django-insecure-local-only-change-me-at-least-32-characters
# Local để trống -> dùng SECRET_KEY. Production bắt buộc khóa riêng >=32 ký tự.
JWT_SIGNING_KEY=
DEBUG=True
DJANGO_ADMIN_ENABLED=True
API_DOCS_ENABLED=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ─────────────────────────────────────────────────────────────
# PostgreSQL
# ─────────────────────────────────────────────────────────────
DB_NAME=ai_career_coach
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# ─────────────────────────────────────────────────────────────
# Redis — cache, token xác thực, cooldown, Celery broker
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
# Để trống nếu không cần query task result.
CELERY_RESULT_BACKEND=

# ─────────────────────────────────────────────────────────────
# Frontend ba cổng, CORS và SEO shell
# ─────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=http://localhost:5173
EMPLOYER_FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5173
# HTML Vite để Django chèn metadata SEO; production dùng http://frontend/.
FRONTEND_SHELL_URL=http://localhost:5173/
FRONTEND_SHELL_TIMEOUT_SECONDS=2
FRONTEND_SHELL_CACHE_SECONDS=30
# Đường dẫn frontend dùng để dựng link trong email.
ADMIN_INVITATION_PATH=/admin/app/invitation
ADMIN_PASSWORD_RESET_PATH=/admin/app/reset-password
EMPLOYER_EMAIL_VERIFICATION_PATH=/tuyendung/app/account/verify
EMPLOYER_PASSWORD_RESET_PATH=/tuyendung/app/reset-password

# ─────────────────────────────────────────────────────────────
# Production hardening (bật khi ENVIRONMENT=production)
# ─────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False
SECURE_PROXY_SSL_HEADER_ENABLED=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# IP/CIDR của reverse proxy được phép gửi X-Forwarded-For. BẮT BUỘC ở production:
# bỏ trống sau nginx nghĩa là mọi người dùng chung một bucket throttle.
# Ví dụ subnet Docker: 172.16.0.0/12
TRUSTED_PROXY_IPS=
# Số hop proxy đứng trước Django (nginx đơn = 1).
TRUSTED_PROXY_HOPS=1

# ─────────────────────────────────────────────────────────────
# Xác thực và phiên đăng nhập
# ─────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
# Admin luôn dùng access token ngắn hơn giá trị chung.
ADMIN_ACCESS_TOKEN_MINUTES=5
# Refresh token chỉ nằm trong cookie HttpOnly, tách theo portal.
# Production bắt buộc Secure=True và SameSite=Lax hoặc Strict.
AUTH_REFRESH_COOKIE_PREFIX=procv_refresh
AUTH_REFRESH_COOKIE_SECURE=False
AUTH_REFRESH_COOKIE_SAMESITE=Lax
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_PATH=/api/
# Ân hạn coi refresh token vừa xoay vòng là đua giữa các tab, không phải bị trộm.
AUTH_REFRESH_REUSE_GRACE_SECONDS=30
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=1800
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=300
# Cửa sổ cho thao tác cần xác thực lại.
AUTH_REAUTH_MAX_AGE_SECONDS=300
# Sau N lần sai mật khẩu, mỗi lần kế tiếp chờ gấp đôi.
LOGIN_BACKOFF_FREE_ATTEMPTS=5
LOGIN_BACKOFF_BASE_SECONDS=2
LOGIN_BACKOFF_MAX_SECONDS=900
LOGIN_BACKOFF_WINDOW_SECONDS=900
# Link xác thực email: hiệu lực và chờ gửi lại (giây).
EMAIL_VERIFICATION_TTL=86400
EMAIL_VERIFICATION_RESEND_COOLDOWN=60
# Link đặt lại mật khẩu: TTL ngắn hơn vì là luồng chiếm tài khoản (giây).
PASSWORD_RESET_TTL=1800
PASSWORD_RESET_RESEND_COOLDOWN=60

# ─────────────────────────────────────────────────────────────
# Social login (OAuth) — ứng viên: Google/Facebook/LinkedIn, NTD: Google.
# Để trống client id/secret -> nút social báo "chưa cấu hình".
# Redirect URI đăng ký với provider:
#   http://localhost:8000/api/auth/oauth/<provider>/callback/
# ─────────────────────────────────────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_FACEBOOK_GRAPH_VERSION=v21.0
OAUTH_LINKEDIN_CLIENT_ID=
OAUTH_LINKEDIN_CLIENT_SECRET=
# Trang frontend nhận one_time_code hoặc error sau callback.
OAUTH_MAIN_CALLBACK_URL=http://localhost:5173/oauth/callback
OAUTH_EMPLOYER_CALLBACK_URL=http://localhost:5173/tuyendung/app/oauth/callback
# TTL (giây) của state OAuth và one_time_code đổi lấy JWT.
OAUTH_STATE_TTL=600
OAUTH_CODE_TTL=120

# ─────────────────────────────────────────────────────────────
# Email (SMTP)
# Để trống EMAIL_HOST_USER -> email in ra console. Gmail cần App Password:
# https://myaccount.google.com/apppasswords (bật 2FA trước).
# ─────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
# Để trống EMAIL_FROM_ADDRESS -> dùng EMAIL_HOST_USER.
EMAIL_FROM_NAME=ProCV
EMAIL_FROM_ADDRESS=
# Ép backend cụ thể; để trống -> smtp khi có EMAIL_HOST_USER, ngược lại console.
EMAIL_BACKEND=
# Ghi đè toàn bộ chuỗi From; để trống -> "EMAIL_FROM_NAME <EMAIL_FROM_ADDRESS>".
DEFAULT_FROM_EMAIL=

# ─────────────────────────────────────────────────────────────
# reCAPTCHA v3 (site key public nằm ở frontend/.env)
# ─────────────────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5

# ─────────────────────────────────────────────────────────────
# Nhà tuyển dụng — điều khoản, xác thực, SMS OTP
# ─────────────────────────────────────────────────────────────
EMPLOYER_TERMS_POLICY_VERSION=2026-07-18
EMPLOYER_DPA_POLICY_VERSION=
EMPLOYER_DPA_DOCUMENT_SHA256=
EMPLOYER_DPA_DOCUMENT_URL=https://tuyendung.topcv.vn/data-processing-agreement
EMPLOYER_DPA_GRACE_DAYS=30
# Development có thể tắt; production mặc định bật.
REQUIRE_APPROVED_EMPLOYER_VERIFICATION=False
EMPLOYER_BADGE_POLICY_MODE=shadow
# Notification/activity/outbox terminal: 24 tháng.
EMPLOYER_EVENT_RETENTION_DAYS=730
# Kiểm tra DNS TXT xác minh domain công ty.
EMPLOYER_DOMAIN_DNS_TIMEOUT_SECONDS=3
EMPLOYER_DOMAIN_RECHECK_BATCH_SIZE=100
# SMS OTP: giữ False tới khi gateway/sender/template được duyệt. Khi bật,
# không fallback email; endpoint là adapter JSON nội bộ qua HTTPS.
EMPLOYER_SMS_OTP_ENABLED=False
EMPLOYER_SMS_PROVIDER=disabled
EMPLOYER_SMS_ENDPOINT_URL=
EMPLOYER_SMS_API_TOKEN=
EMPLOYER_SMS_SENDER=
EMPLOYER_SMS_TEMPLATE_ID=
# Fernet key riêng và HMAC secret >=32 ký tự; không dùng lại SECRET_KEY/JWT key.
EMPLOYER_SMS_PAYLOAD_ENCRYPTION_KEY=
EMPLOYER_SMS_CHALLENGE_HMAC_KEY=
EMPLOYER_SMS_CONNECT_TIMEOUT_SECONDS=2
EMPLOYER_SMS_READ_TIMEOUT_SECONDS=5
EMPLOYER_SMS_DISPATCH_STALE_SECONDS=300
# VietQR — đối chiếu MST khi nộp hồ sơ xác thực/chỉnh sửa pháp lý.
VIETQR_TAX_LOOKUP_ENABLED=True
VIETQR_TAX_LOOKUP_BASE_URL=https://api.vietqr.io/v2/business
VIETQR_TAX_LOOKUP_CONNECT_TIMEOUT=2
VIETQR_TAX_LOOKUP_READ_TIMEOUT=3
VIETQR_TAX_LOOKUP_SUCCESS_TTL=86400
VIETQR_TAX_LOOKUP_NEGATIVE_TTL=900

# ─────────────────────────────────────────────────────────────
# Tin tuyển dụng, consent và job-view tracking
# ─────────────────────────────────────────────────────────────
# Hạn nhận hồ sơ do NTD chọn; vòng đời công khai tối đa 90 ngày.
JOB_POSTING_DEFAULT_DEADLINE_DAYS=30
JOB_POSTING_MAX_DEADLINE_DAYS=90
JOB_POSTING_MAX_PUBLIC_LIFETIME_DAYS=90
# legacy | shadow | enforce
JOB_LIFECYCLE_V2_MODE=legacy
JOB_VIEW_DEDUP_TTL_SECONDS=86400
JOB_VIEWER_COOKIE_NAME=procv_viewer_id
CONSENT_POLICY_VERSION=1
CONSENT_COOKIE_NAME=procv_consent

# ─────────────────────────────────────────────────────────────
# Help Center và thông báo đa cổng
# ─────────────────────────────────────────────────────────────
KNOWLEDGEBASE_PUBLIC_ENABLED=true
# Chỉ bật sau khi command readiness và SEO regression pass.
KNOWLEDGEBASE_SEARCH_INDEX_ENABLED=false
# Rỗng = tắt. Bật lần lượt:
# admin_workspace → employer_marketing → employer_workspace → candidate
ANNOUNCEMENT_REMOTE_ENABLED_SURFACES=

# ─────────────────────────────────────────────────────────────
# Media và upload
# ─────────────────────────────────────────────────────────────
# URL public serve /media/ (vd https://static.example.com). Để trống ở local.
MEDIA_PUBLIC_BASE_URL=
# Đường dẫn tương đối so với backend/; Docker Compose override sang /app/...
# LEGACY_MEDIA_ROOT chỉ là input cho lệnh migrate media, không được serve.
LEGACY_MEDIA_ROOT=media
PUBLIC_MEDIA_ROOT=public-media
PRIVATE_MEDIA_ROOT=private-media
UPLOAD_QUARANTINE_ROOT=quarantine
IMAGE_UPLOAD_MAX_SIZE=5242880
# File nguồn import CV bị Celery beat xóa sau số ngày này.
CV_IMPORT_SOURCE_RETENTION_DAYS=30
# Quarantine pipeline: giữ tắt tới khi ClamAV readiness pass. Cấu hình sai sẽ
# fail closed, không bao giờ lưu file khi chưa có verdict.
UPLOAD_QUARANTINE_ENABLED=False
EMPLOYER_UPLOAD_SESSION_REQUIRED=False
CANDIDATE_UPLOAD_SESSION_REQUIRED=False
UPLOAD_SCANNER_BACKEND=apps.uploads.services.scanners.ClamAVStreamScanner
UPLOAD_SESSION_ALLOWED_PURPOSES=employer_verification,employer_company_update,candidate_cv
UPLOAD_MAX_BYTES=26214400
UPLOAD_OWNER_MAX_ACTIVE_SESSIONS=10
UPLOAD_OWNER_MAX_ACTIVE_BYTES=104857600
UPLOAD_SPOOL_MEMORY_BYTES=5242880
UPLOAD_DOCX_MAX_ENTRIES=500
UPLOAD_DOCX_MAX_UNCOMPRESSED_BYTES=104857600
UPLOAD_DOCX_MAX_COMPRESSION_RATIO=100
UPLOAD_SESSION_TTL_SECONDS=86400
UPLOAD_WRITE_LEASE_SECONDS=120
UPLOAD_SCAN_LEASE_SECONDS=120
UPLOAD_SCAN_MAX_ATTEMPTS=4
UPLOAD_SCAN_RETRY_BASE_SECONDS=30
UPLOAD_CLEAN_RETENTION_DAYS=730
UPLOAD_EVIDENCE_RETENTION_DAYS=730
UPLOAD_CLEANUP_BATCH_SIZE=100
# Docker Compose tự trỏ CLAMAV_HOST về service clamav (profile scanner).
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT_SECONDS=2
CLAMAV_READ_TIMEOUT_SECONDS=60
CLAMAV_STREAM_CHUNK_BYTES=1048576

# ─────────────────────────────────────────────────────────────
# Cloudflare R2 — chỉ backend đọc. Đủ giá trị thì media public dùng bucket
# public, default storage dùng bucket private. Mỗi bucket một token riêng.
# ─────────────────────────────────────────────────────────────
R2_ENDPOINT_URL=
R2_REGION_NAME=auto
R2_PUBLIC_ACCESS_KEY_ID=
R2_PUBLIC_SECRET_ACCESS_KEY=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=
R2_QUARANTINE_ACCESS_KEY_ID=
R2_QUARANTINE_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=procv-public-media
R2_PRIVATE_BUCKET=procv-private-files
R2_QUARANTINE_BUCKET=procv-upload-quarantine
R2_PUBLIC_BASE_URL=

# ─────────────────────────────────────────────────────────────
# Generative AI — hard switch toàn nền; site setting chỉ thu hẹp rollout.
# gemini_developer dùng GEMINI_API_KEY; vertex dùng ADC + GOOGLE_CLOUD_*.
# ─────────────────────────────────────────────────────────────
AI_RUNTIME_ENABLED=True
AI_PROVIDER_BACKEND=gemini_developer
AI_PROVIDER_API_VERSION=v1
AI_PROVIDER_TIMEOUT_SECONDS=40
AI_PROVIDER_MAX_ATTEMPTS=2
AI_PROVIDER_RETRY_BASE_SECONDS=0.5
AI_JOB_GENERATION_MODEL=gemini-3.5-flash-lite
AI_JOB_GENERATION_MODEL_ALLOWLIST=gemini-3.5-flash-lite
AI_JOB_GENERATION_DAILY_LIMIT=10
AI_JOB_GENERATION_LEASE_SECONDS=85
AI_JOB_GENERATION_CONTENT_RETENTION_DAYS=90
AI_INVOCATION_METADATA_RETENTION_DAYS=365
# USD / một triệu token; production cập nhật theo bảng giá provider khi deploy.
AI_MODEL_PRICING_USD={"gemini-3.5-flash-lite":{"input":"0","output":"0"}}
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Import CV bằng AI: admin chọn provider/model, secret chỉ đọc từ env.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────
# Thanh toán — Site Settings chỉ hiển thị trạng thái "đã cấu hình".
# ─────────────────────────────────────────────────────────────
VNPAY_HASH_SECRET=
