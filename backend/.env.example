# Cấu hình tối thiểu để chạy backend local. Sao chép thành backend/.env.
# Các tích hợp, feature flag, policy và tuning nằm trong .env.optional.example;
# chỉ sao chép nhóm thực sự cần dùng. Process environment luôn ưu tiên .env.

# Django local
ENVIRONMENT=development
SECRET_KEY=django-insecure-local-only-change-me-at-least-32-characters
DEBUG=True
DJANGO_ADMIN_ENABLED=True

# PostgreSQL native local. Docker Compose override host/port bằng service nội bộ.
DB_NAME=ai_career_coach
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Origin và URL ba cổng local
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173
EMPLOYER_FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5173

# Cache và Celery native local. Docker Compose override hostname redis.
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
