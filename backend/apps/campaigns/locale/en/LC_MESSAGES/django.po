msgid "Ảnh bị lỗi hoặc không đọc được."
msgstr "The image is corrupted or cannot be read."

msgid "Ảnh không thuộc chiến dịch hoặc công ty này."
msgstr "The image does not belong to this campaign or company."

msgid "Ảnh đã bị xóa, hãy tải lại."
msgstr "The image was deleted. Please upload it again."

msgid "Mỗi bài tối đa %(count)s ảnh."
msgid_plural "Mỗi bài tối đa %(count)s ảnh."
msgstr[0] "Each post can have at most %(count)s image."
msgstr[1] "Each post can have at most %(count)s images."

msgid "Chưa gỡ được bài kênh \"%(channel)s\" khỏi %(network)s. Hãy tự xóa bài: %(permalink)s"
msgstr "Could not remove the post of channel \"%(channel)s\" from %(network)s. Please delete it yourself: %(permalink)s"

msgid "Bạn không có quyền với bài đăng này."
msgstr "You do not have access to this post."

msgid "Chưa đăng được bài của kênh \"%(channel)s\" lên %(network)s. Mở chiến dịch để hẹn lại."
msgstr "Could not publish the post of channel \"%(channel)s\" to %(network)s. Open the campaign to reschedule."

msgid "Chọn thời điểm từ bây giờ trở đi."
msgstr "Choose a time from now onwards."

msgid "Kênh chưa có nội dung. Soạn nội dung trước khi hẹn đăng."
msgstr "The channel has no content yet. Write the content before scheduling a post."

msgid "Bài đã đăng hoặc đã hủy."
msgstr "The post has already been published or cancelled."

msgid "Chỉ hẹn lại được bài chưa đăng."
msgstr "Only unpublished posts can be rescheduled."

msgid "%(network)s chưa kết nối hoặc không thuộc tài khoản này."
msgstr "%(network)s is not connected or does not belong to this account."

msgid "%(network)s nhận tối đa %(count)s ký tự mỗi bài, tính cả link."
msgstr "%(network)s accepts at most %(count)s characters per post, including the link."

msgid "%(network)s cần ít nhất một ảnh."
msgstr "%(network)s needs at least one image."

