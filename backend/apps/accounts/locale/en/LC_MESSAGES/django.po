msgid "Chuyển tài khoản cấm sang tạm khóa, rà soát và gỡ giữ tài nguyên, sau đó mới mở lại."
msgstr "Move the banned account to suspended, review and release resource holds, then reactivate it."

msgid "Policy hold tạm thời được gỡ khi mở lại; trạng thái nghiệp vụ gốc được giữ nguyên."
msgstr "Temporary policy holds are released on reactivation; the original business status is kept."

msgid "Cần gỡ giữ tài nguyên bị cấm/khóa cũ trước khi mở lại."
msgstr "Resource holds from the earlier ban/suspension must be released before reactivation."

msgid "Tài khoản đang bị hạn chế. Không thể thay đổi dữ liệu cho đến khi được mở lại."
msgstr "This account is restricted. Data cannot be changed until it is reactivated."

msgid "Bạn không thể tự khôi phục danh tính tài khoản của mình."
msgstr "You cannot recover the identity of your own account."

msgid "Tài khoản đã bị xóa và không thuộc luồng khôi phục này."
msgstr "The account has been deleted and is not eligible for this recovery flow."

msgid "Tài khoản đang chờ kích hoạt phải được xử lý qua quy trình lời mời."
msgstr "Accounts pending activation must be handled through the invitation process."

msgid "Bạn không thể tự gỡ policy hold của tài khoản mình."
msgstr "You cannot release policy holds on your own account."

msgid "Chỉ được gỡ policy hold cho tài khoản nhà tuyển dụng đang tạm khóa."
msgstr "Policy holds can only be released for suspended employer accounts."

msgid "Tài khoản không còn policy hold cần gỡ."
msgstr "This account has no policy holds to release."

msgid "Email của tài khoản đã được xác minh."
msgstr "The account email is already verified."

msgid "Chỉ có thể gửi liên kết đặt lại mật khẩu cho tài khoản đang hoạt động. Hãy mở khóa tài khoản trước."
msgstr "Password reset links can only be sent to active accounts. Reactivate the account first."

msgid "Bạn không thể tự thay đổi trạng thái tài khoản của mình."
msgstr "You cannot change the status of your own account."

msgid "Tài khoản đã bị xóa không thuộc workflow trạng thái này."
msgstr "Deleted accounts are not part of this status workflow."

msgid "Tài khoản đang chờ kích hoạt phải được xử lý qua workflow lời mời."
msgstr "Accounts pending activation must be handled through the invitation workflow."

msgid "Không thể chuyển trực tiếp giữa hai trạng thái đã chọn."
msgstr "Cannot move directly between the two selected statuses."

msgid "Cấm hoặc bắt đầu khôi phục tài khoản bị cấm chỉ dành cho superuser."
msgstr "Only a superuser can ban an account or start reactivating a banned account."

msgid "Không thể khóa superuser hoạt động cuối cùng."
msgstr "Cannot suspend the last active superuser."

msgid "Cần rà soát và gỡ policy hold của tài nguyên trước khi mở lại tài khoản."
msgstr "Resource policy holds must be reviewed and released before reactivating the account."

msgid "Dữ liệu tài khoản đã thay đổi."
msgstr "The account data has changed."

msgid "Chỉ superuser được thay đổi tài khoản quản trị."
msgstr "Only a superuser can change administrator accounts."

msgid "Vui lòng nhập lý do thao tác."
msgstr "Please enter a reason for this action."

msgid "Lý do không được vượt quá 500 ký tự."
msgstr "The reason must not exceed 500 characters."

msgid "Bằng chứng xác minh cần mô tả cụ thể và có ít nhất 20 ký tự."
msgstr "Verification evidence must be specific and at least 20 characters."

msgid "Liên kết có hiệu lực trong 72 giờ và chỉ dùng được một lần."
msgstr "This link is valid for 72 hours and can only be used once."

msgid "Lời mời tham gia hệ thống quản trị %(site_name)s"
msgstr "Invitation to join the %(site_name)s admin console"

msgid "<strong>%(inviter)s</strong> đã mời bạn tham gia hệ thống quản trị."
msgstr "<strong>%(inviter)s</strong> has invited you to join the admin console."

msgid "Hoàn tất tài khoản"
msgstr "Complete your account"

msgid "Xin chào <strong>%(name)s</strong>,"
msgstr "Hello <strong>%(name)s</strong>,"

msgid "Hoàn tất tài khoản tại: %(link)s"
msgstr "Complete your account at: %(link)s"

msgid "%(inviter)s đã mời bạn tham gia hệ thống quản trị %(site_name)s."
msgstr "%(inviter)s has invited you to join the %(site_name)s admin console."

msgid "Xin chào %(name)s,"
msgstr "Hello %(name)s,"

msgid "Liên kết mời không hợp lệ."
msgstr "Invalid invitation link."

msgid "Chỉ superuser được mời và quản lý tài khoản quản trị."
msgstr "Only a superuser can invite and manage administrator accounts."

msgid "Liên kết mời không còn hiệu lực."
msgstr "This invitation link is no longer valid."

msgid "Lời mời đã được sử dụng hoặc thu hồi."
msgstr "This invitation has already been used or revoked."

msgid "Liên kết mời đã hết hạn."
msgstr "This invitation link has expired."

msgid "Lời mời không còn có thể gửi lại."
msgstr "This invitation can no longer be resent."

msgid "Chỉ lời mời đang chờ mới được thu hồi."
msgstr "Only pending invitations can be revoked."

msgid "Tài khoản không còn ở trạng thái chờ."
msgstr "The account is no longer pending."

msgid "Email đã có tài khoản quản trị hoạt động."
msgstr "This email already has an active administrator account."

msgid "Tài khoản đã có lời mời đang chờ xử lý."
msgstr "This account already has a pending invitation."

msgid "Thiết bị không xác định"
msgstr "Unknown device"

msgid "%(browser)s trên %(os)s"
msgstr "%(browser)s on %(os)s"

msgid "Không tìm thấy phiên đăng nhập."
msgstr "Sign-in session not found."

msgid "Trình duyệt khác"
msgstr "Other browser"

msgid "Hệ điều hành khác"
msgstr "Other operating system"

msgid "Vui lòng xác thực captcha."
msgstr "Please complete the captcha."

msgid "Xác thực captcha thất bại."
msgstr "Captcha verification failed."

msgid "Captcha không hợp lệ cho trang này."
msgstr "The captcha is not valid for this site."

msgid "Captcha không hợp lệ cho hành động này."
msgstr "The captcha is not valid for this action."

msgid "Xác thực captcha thất bại (độ tin cậy thấp)."
msgstr "Captcha verification failed (low confidence score)."

msgid "Không thể xác thực captcha, vui lòng thử lại."
msgstr "Could not verify the captcha, please try again."

msgid "Ứng viên"
msgstr "Candidate"

msgid "Thay đổi được thực hiện bởi quản trị viên theo yêu cầu hỗ trợ đã xác minh."
msgstr "This change was made by an administrator following a verified support request."

msgid "không xác định"
msgstr "unknown"

msgid "Xác thực tài khoản Nhà tuyển dụng tại %(site_name)s"
msgstr "Verify your employer account at %(site_name)s"

msgid "Kính gửi Quý khách hàng <strong>%(name)s</strong> — Mã NTD <strong>%(code)s</strong>,"
msgstr "Dear <strong>%(name)s</strong> — Employer ID <strong>%(code)s</strong>,"

msgid "Cảm ơn Quý khách đã tin tưởng lựa chọn %(site_name)s đồng hành trong quá trình tuyển dụng. Tài khoản Nhà tuyển dụng đã được đăng ký thành công với email <a href=\"mailto:%(email)s\" style=\"color:#00a854\">%(email)s</a>."
msgstr "Thank you for choosing %(site_name)s as your recruitment partner. Your employer account has been registered successfully with the email <a href=\"mailto:%(email)s\" style=\"color:#00a854\">%(email)s</a>."

msgid "Không chia sẻ mật khẩu hoặc liên kết xác thực với bất kỳ ai. %(site_name)s không yêu cầu chuyển khoản vào tài khoản cá nhân."
msgstr "Never share your password or verification link with anyone. %(site_name)s will never ask you to transfer money to a personal account."

msgid "Liên kết có hiệu lực trong <strong>%(hours)s giờ</strong>. Nếu Quý khách không thực hiện đăng ký này, vui lòng bỏ qua email và liên hệ bộ phận hỗ trợ."
msgstr "This link is valid for <strong>%(hours)s hours</strong>. If you did not make this registration, please ignore this email and contact our support team."

msgid "Xác thực địa chỉ email của bạn tại %(site_name)s"
msgstr "Verify your email address at %(site_name)s"

msgid "Cảm ơn bạn đã đăng ký tài khoản tại %(site_name)s. Nhấn nút bên dưới để xác thực địa chỉ email."
msgstr "Thank you for creating an account at %(site_name)s. Click the button below to verify your email address."

msgid "Quản trị"
msgstr "Admin"

msgid "Nhà tuyển dụng"
msgstr "Employer"

msgid "Email đăng nhập tài khoản %(portal)s %(site_name)s vừa được thay đổi"
msgstr "The sign-in email of your %(portal)s account at %(site_name)s has been changed"

msgid "Email đăng nhập của tài khoản <strong>%(portal)s</strong> tại %(site_name)s vừa được đổi từ <strong>%(old_email)s</strong> sang <strong>%(new_email)s</strong>."
msgstr "The sign-in email of your <strong>%(portal)s</strong> account at %(site_name)s has been changed from <strong>%(old_email)s</strong> to <strong>%(new_email)s</strong>."

msgid "Nếu bạn <strong>không</strong> yêu cầu thay đổi này, tài khoản của bạn có thể đã bị xâm phạm. Vui lòng liên hệ ngay %(support)s để được trợ giúp."
msgstr "If you did <strong>not</strong> request this change, your account may have been compromised. Please contact %(support)s immediately for help."

msgid "được cập nhật"
