msgid "Tài khoản không còn khả dụng."
msgstr "This account is no longer available."

msgid "Thông tin xác thực đã thay đổi. Vui lòng đăng nhập lại."
msgstr "Your credentials have changed. Please sign in again."

msgid "Phiên đăng nhập đã hết hạn hoặc bị thu hồi."
msgstr "Your session has expired or been revoked."

msgid "Bằng chứng xác minh cần có ít nhất 20 ký tự."
msgstr "Verification evidence must be at least 20 characters."

msgid "Bằng chứng xác minh không được vượt quá 500 ký tự."
msgstr "Verification evidence must not exceed 500 characters."

msgid "Email mới trùng với email hiện tại."
msgstr "The new email is the same as the current email."

msgid "Email này đã thuộc một tài khoản cùng loại."
msgstr "This email already belongs to an account of the same type."

msgid "Bằng chứng xử lý cần mô tả cụ thể và có ít nhất 20 ký tự."
msgstr "Enforcement evidence must be specific and at least 20 characters."

msgid "Chọn nhóm vi phạm khi cấm tài khoản."
msgstr "Select a violation category when banning an account."

msgid "Họ tên cần ít nhất 2 ký tự."
msgstr "Full name must be at least 2 characters."

msgid "Mật khẩu xác nhận không khớp."
msgstr "The password confirmation does not match."

msgid "Email hoặc mật khẩu không đúng. Vui lòng thử lại."
msgstr "Incorrect email or password. Please try again."

msgid "Email này đã được sử dụng cho một tài khoản khác."
msgstr "This email is already associated with an account."

msgid "Mật khẩu phải bao gồm chữ hoa, chữ thường và ký tự số."
msgstr "Password must contain uppercase letters, lowercase letters and digits."

msgid "Nhập mã xác minh gửi tới email."
msgstr "Enter the verification code sent to your email."

msgid "Mã xác minh không đúng hoặc đã hết hạn."
msgstr "The verification code is incorrect or has expired."

msgid "Nhập mật khẩu hiện tại."
msgstr "Enter your current password."

msgid "Mật khẩu hiện tại không đúng."
msgstr "The current password is incorrect."

msgid "Chưa nộp"
msgstr "Not submitted"

msgid "Vui lòng nhập họ và tên."
msgstr "Please enter your full name."

msgid "Họ và tên cần ít nhất 2 ký tự."
msgstr "Full name must be at least 2 characters."

msgid "Nhà tuyển dụng phải đổi số điện thoại qua luồng xác thực SMS."
msgstr "Employers must change their phone number through the SMS verification flow."

msgid "Số điện thoại không hợp lệ (VD: 0912345678 hoặc +84912345678)."
msgstr "Invalid phone number (e.g. 0912345678 or +84912345678)."

msgid "Hãy đăng nhập lại với OAuth trước khi đổi email."
msgstr "Please sign in again with OAuth before changing your email."

msgid "Gỡ policy hold chỉ dành cho superuser."
msgstr "Only a superuser can release policy holds."

msgid "Đã xếp lịch gửi email đặt lại mật khẩu."
msgstr "The password reset email has been scheduled."

msgid "Đã xếp lịch gửi email xác minh."
msgstr "The verification email has been scheduled."

msgid "Phạm vi tài khoản không hợp lệ."
msgstr "Invalid account scope."

msgid "Vai trò tài khoản không hợp lệ."
msgstr "Invalid account role."

msgid "Nhà tuyển dụng không thuộc phạm vi người dùng."
msgstr "Employers are not within the user scope."

msgid "Phạm vi nhà tuyển dụng chỉ chấp nhận role employer."
msgstr "The employer scope only accepts the employer role."

msgid "Trạng thái tài khoản không hợp lệ."
msgstr "Invalid account status."

msgid "Trạng thái liên kết công ty không hợp lệ."
msgstr "Invalid company link status."

msgid "Việc cần làm không hợp lệ."
msgstr "Invalid next action."

msgid "Tài khoản quản trị đã được kích hoạt."
msgstr "The administrator account has been activated."

msgid "Đã đăng xuất."
msgstr "Signed out."

msgid "Đã đăng xuất khỏi tất cả thiết bị."
msgstr "Signed out of all devices."

msgid "Cổng đăng nhập không hợp lệ."
msgstr "Invalid sign-in portal."

msgid "Cập nhật mật khẩu thành công."
msgstr "Password updated successfully."

msgid "Cần phiên refresh hiện tại để đổi mật khẩu."
msgstr "The current refresh session is required to change your password."

msgid "Tài khoản đã có mật khẩu, hãy dùng mật khẩu hiện tại."
msgstr "This account already has a password; use your current password."

msgid "Đã gửi mã xác minh tới %(email)s."
msgstr "A verification code has been sent to %(email)s."

msgid "Nếu email này đã đăng ký tài khoản, chúng tôi đã gửi liên kết đặt lại mật khẩu. Vui lòng kiểm tra hòm thư (kể cả mục Spam)."
msgstr "If this email is registered, we have sent a password reset link. Please check your inbox (including the Spam folder)."

msgid "Đặt lại mật khẩu thành công."
msgstr "Password reset successfully."

msgid "Đã đăng xuất khỏi các thiết bị khác."
msgstr "Signed out of other devices."

msgid "Không tìm thấy phiên làm mới."
msgstr "Refresh session not found."

msgid "Phiên làm mới không hợp lệ hoặc đã hết hạn."
msgstr "The refresh session is invalid or has expired."

msgid "Email xác thực đang được gửi. Vui lòng kiểm tra hòm thư sau ít phút."
msgstr "The verification email is being sent. Please check your inbox in a few minutes."

msgid "Xác thực email thành công."
msgstr "Email verified successfully."

