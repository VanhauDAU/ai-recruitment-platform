msgid "Chỉ được loại tối đa %(count)s tin."
msgstr "You can exclude at most %(count)s job postings."

msgid "Vui lòng mô tả cụ thể khi chọn \"Lý do khác\"."
msgstr "Please describe the issue when choosing \"Other reason\"."

msgid "Ngày kết thúc phải từ ngày bắt đầu trở đi."
msgstr "The end date must be on or after the start date."

msgid "Nhập căn cứ xác nhận vi phạm."
msgstr "Enter the grounds for confirming the violation."

msgid "Địa điểm làm việc phải là tỉnh/thành hoặc phường/xã hợp lệ."
msgstr "The work location must be a valid province/city or ward/commune."

msgid "Địa điểm đã ngừng hoạt động."
msgstr "This location is no longer active."

msgid "Một khung giờ phải có đủ ngày bắt đầu, ngày kết thúc và giờ bắt đầu."
msgstr "A schedule slot needs a start day, an end day and a start time."

msgid "Cần nhập khung ngày/giờ hoặc ghi chú lịch làm việc."
msgstr "Enter a day/time slot or a work schedule note."

msgid "Quyền lợi đã ngừng hoạt động."
msgstr "This benefit is no longer active."

msgid "Ngoại ngữ đã ngừng hoạt động."
msgstr "This language is no longer active."

msgid "Cần từ 1 đến tối đa 5 email nhận hồ sơ."
msgstr "Enter between 1 and 5 application emails."

msgid "Danh mục đã ngừng hoạt động."
msgstr "This category is no longer active."

msgid "Loại danh mục không phù hợp với vai trò đã chọn."
msgstr "The category type does not match the selected role."

msgid "Ghim vị trí cần đủ cả vĩ độ và kinh độ."
msgstr "A location pin needs both latitude and longitude."

msgid "Ghim vị trí phải nằm trong lãnh thổ Việt Nam."
msgstr "The location pin must be inside Vietnam."

msgid "Ghim vị trí nằm ngoài tỉnh/thành đã chọn."
msgstr "The location pin is outside the selected province."

msgid "Giờ kết thúc phải sau giờ bắt đầu."
msgstr "The end time must be after the start time."

msgid "Chọn hạn nhận hồ sơ."
msgstr "Select an application deadline."

msgid "Bạn cần đồng ý nhận gợi ý việc làm trước khi hệ thống đọc dữ liệu CV."
msgstr "You need to consent to job recommendations before the system can read your CV data."

