msgid "Hình thức làm việc không được trùng nhau."
msgstr "Work arrangements must not be duplicated."

msgid "Chế độ brief yêu cầu brief và không nhận source_text."
msgstr "Brief mode requires a brief and does not accept source_text."

msgid "Chế độ JD yêu cầu source_text và không nhận brief."
msgstr "JD mode requires source_text and does not accept a brief."

msgid "Vui lòng nhập từ khóa việc làm."
msgstr "Please enter a job keyword."

msgid "Không được chọn trùng ngành nghề."
msgstr "Job categories must not be selected twice."

msgid "Trạng thái chỉ được thay đổi sau khi tạo thông báo."
msgstr "The status can only be changed after the job alert is created."

msgid "Địa điểm này không phải tỉnh/thành."
msgstr "This location is not a province or city."

msgid "Địa điểm này không phải phường/xã."
msgstr "This location is not a ward or commune."

msgid "Cần chọn tỉnh/thành trước khi chọn phường/xã."
msgstr "Select a province or city before selecting a ward or commune."

msgid "Phường/xã không thuộc tỉnh/thành đã chọn."
msgstr "The ward or commune does not belong to the selected province or city."

msgid "Chiến dịch không thuộc tài khoản này."
msgstr "This recruitment campaign does not belong to this account."

msgid "Không thể thêm tin tuyển dụng vào chiến dịch đã hủy hoặc hoàn tất."
msgstr "Job postings cannot be added to a cancelled or completed recruitment campaign."

msgid "Chỉ được nhập tối đa 5 email nhận hồ sơ."
msgstr "You can enter at most 5 application emails."

msgid "Email nhận hồ sơ không được trùng nhau."
msgstr "Application emails must not be duplicated."

msgid "Chỉ liên kết kết quả AI khi tạo tin mới."
msgstr "An AI result can only be linked when creating a new job posting."

msgid "Nhập nội dung email thông báo cho ứng viên."
msgstr "Enter the email message for candidates."

msgid "Chọn loại lương và nhập đầy đủ mức lương."
msgstr "Select a salary type and enter the full salary."

msgid "Các lý do không được trùng nhau."
msgstr "Reasons must not be duplicated."

msgid "Tuổi tối thiểu phải từ 15 đến 100."
msgstr "The minimum age must be between 15 and 100."

msgid "Tuổi tối đa phải từ 15 đến 100."
msgstr "The maximum age must be between 15 and 100."

msgid "Tuổi tối đa không được nhỏ hơn tuổi tối thiểu."
msgstr "The maximum age cannot be lower than the minimum age."

msgid "Lương thỏa thuận không được có mức tối thiểu/tối đa."
msgstr "A negotiable salary cannot have a minimum or maximum amount."

msgid "Chọn ít nhất một hình thức làm việc."
msgstr "Select at least one work arrangement."

msgid "Danh sách hình thức làm việc không hợp lệ."
msgstr "The list of work arrangements is invalid."

msgid "Chỉ được chọn một vị trí chuyên môn chính."
msgstr "Only one primary specialization can be selected."

msgid "Danh mục không được chọn trùng."
msgstr "Categories must not be selected twice."

msgid "Danh sách không được chứa mục trùng."
msgstr "The list must not contain duplicate items."

msgid "Nhập ít nhất một mức lương."
msgstr "Enter at least one salary amount."

msgid "Loại lương này cần mức lương tối thiểu."
msgstr "This salary type requires a minimum salary."

msgid "Loại lương này cần mức lương tối đa."
msgstr "This salary type requires a maximum salary."

msgid "Mức lương tối đa không được nhỏ hơn mức tối thiểu."
msgstr "The maximum salary cannot be lower than the minimum salary."

msgid "Chọn lý do xử lý."
msgstr "Select a reason for this action."

msgid "Nhập ghi chú xử lý."
msgstr "Enter a note for this action."

msgid "Không yêu cầu kinh nghiệm"
msgstr "No experience required"

msgid "Không yêu cầu bằng cấp"
msgstr "No degree required"

