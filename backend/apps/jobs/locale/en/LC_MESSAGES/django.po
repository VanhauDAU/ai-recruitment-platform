msgstr "Age %(min)s - %(max)s"

msgid "Giới tính: %(gender)s"
msgstr "Gender: %(gender)s"

msgid "%(years)s kinh nghiệm"
msgstr "%(years)s of experience"

msgid "Từ %(age)s tuổi trở lên"
msgstr "Aged %(age)s or older"

msgid "Từ %(level)s trở lên"
msgstr "%(level)s or higher"

msgid "Đến %(age)s tuổi"
msgstr "Up to %(age)s years old"

