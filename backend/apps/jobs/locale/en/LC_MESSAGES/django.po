msgid "Chọn thời gian hiển thị tin."
msgstr "Select how long the posting is displayed."

msgid "Thời gian hiển thị phải từ 1 đến %(days)s ngày."
msgstr "The display period must be between 1 and %(days)s days."

msgid "Thời gian hiển thị mới phải dài hơn hiện tại."
msgstr "The new display period must be longer than the current one."

msgid "Tin đã thay đổi sau khi bạn mở bản xem trước. Vui lòng tải lại."
msgstr "The posting changed after you opened the preview. Please reload."

msgid "Chỉ có thể tạm ẩn tin đang tuyển."
msgstr "Only postings that are hiring can be hidden."

msgid "Tin đã bị tạm ẩn."
msgstr "The posting is already hidden."

msgid "Tin không bị moderation hold."
msgstr "The posting is not under a moderation hold."

msgid "Không thể yêu cầu chỉnh sửa tin ở trạng thái hiện tại."
msgstr "Changes cannot be requested for the posting in its current state."

msgid "Tin \"%(title)s\" đang tạm ẩn: %(reason)s. Hãy chỉnh sửa rồi gửi duyệt lại."
msgstr "Job posting \"%(title)s\" is hidden: %(reason)s. Please edit it and resubmit it for review."

msgid "Bạn không có quyền gửi duyệt lại tin này."
msgstr "You do not have permission to resubmit this posting for review."

msgid "Tin này không ở trạng thái cần chỉnh sửa."
msgstr "This posting has no requested changes."

msgid "Tin đã được gửi duyệt lại, vui lòng chờ quản trị viên."
msgstr "The posting has already been resubmitted. Please wait for an administrator."

msgid "Bạn chưa sửa nội dung nào. Hãy chỉnh sửa tin trước khi gửi duyệt lại."
msgstr "You have not changed anything yet. Edit the posting before resubmitting it for review."

msgid "Loại tạm giữ không hợp lệ."
msgstr "Invalid hold type."

msgid "Báo cáo không thuộc tin này."
msgstr "The report does not belong to this posting."

msgid "Nhập căn cứ tạm ẩn tin."
msgstr "Enter the grounds for hiding the posting."

msgid "Nhập lý do khôi phục hiển thị."
msgstr "Enter the reason for restoring visibility."

msgid "Chỉ yêu cầu chỉnh sửa với lý do nhà tuyển dụng sửa được."
msgstr "Only request changes for reasons the employer can fix."

msgid "Nêu rõ nội dung cần chỉnh sửa."
msgstr "Describe what needs to be changed."

msgid "Workspace chưa sẵn sàng."
msgstr "The workspace is not ready yet."

msgid "Cập nhật thông tin công ty trước khi đăng tin."
msgstr "Update your company information before posting a job."

msgid "%(title)s (bản sao)"
msgstr "%(title)s (copy)"

msgid "Bạn không có quyền chỉnh sửa tin này."
msgstr "You do not have permission to edit this posting."

msgid "Bạn không có quyền dùng tin này."
msgstr "You do not have permission to use this posting."

msgid "Bạn không có quyền sao chép tin này."
msgstr "You do not have permission to duplicate this posting."

msgid "Dùng thao tác gia hạn để thay đổi thời gian hiển thị của tin đã đăng."
msgstr "Use the extend action to change the display period of a published posting."

msgid "Tin đang thuộc một chiến dịch khác còn chạy."
msgstr "The posting belongs to another recruitment campaign that is still running."

msgid "Hạn nhận hồ sơ của tin sau ngày kết thúc chiến dịch."
msgstr "The posting's application deadline is after the recruitment campaign's end date."

msgid "Không thể sao chép khi tin hoặc chiến dịch đang bị tạm giữ."
msgstr "The posting cannot be duplicated while it or its recruitment campaign is on hold."

msgid "Chỉ có thể xóa tin nháp của bạn."
msgstr "You can only delete your own draft postings."

msgid "Không thể xóa tin đã từng được đăng."
msgstr "A posting that has been published cannot be deleted."

msgid "Chiến dịch của tin vừa thay đổi. Vui lòng tải lại."
msgstr "The posting's recruitment campaign has just changed. Please reload."

msgid "Chiến dịch vừa thay đổi. Vui lòng tải lại."
msgstr "The recruitment campaign has just changed. Please reload."

msgid "Bạn không có quyền dùng chiến dịch này."
msgstr "You do not have permission to use this recruitment campaign."

msgid "Chiến dịch đang bị policy hold."
msgstr "The recruitment campaign is under a policy hold."

msgid "Chiến dịch này không còn nhận tin tuyển dụng."
msgstr "This recruitment campaign no longer accepts job postings."

msgid "Tin tuyển dụng đang bị tạm ẩn nên chưa thể thay đổi."
msgstr "The job posting is hidden, so it cannot be changed yet."

msgid "Bạn không có quyền đăng tin này."
msgstr "You do not have permission to publish this posting."

msgid "Mở lại tin đã đóng thay vì đăng lại."
msgstr "Reopen the closed posting instead of publishing it again."

msgid "Chỉ có thể mở lại tin đã đóng của bạn."
msgstr "You can only reopen your own closed postings."

msgid "Chỉ có thể gia hạn tin đang tuyển của bạn."
msgstr "You can only extend your own postings that are hiring."

msgid "Chỉ có thể đóng tin đang tuyển của bạn."
msgstr "You can only close your own postings that are hiring."

msgid "Hạn gia hạn phải sau hạn nộp hiện tại."
msgstr "The new deadline must be after the current application deadline."

msgid "Không thể rút ngắn hạn nhận hồ sơ khi gia hạn."
msgstr "The application deadline cannot be shortened when extending."

msgid "Chỉ có thể gia hạn tin hết hạn trong vòng %(days)s ngày."
msgstr "Expired postings can only be extended within %(days)s days."

msgid "Bạn đã dùng hết %(limit)s lượt đăng tin miễn phí. Hoàn tất xác thực hồ sơ và đạt Cấp 3 để có quota %(verified_limit)s tin."
msgstr "You have used all %(limit)s free job posts. Complete account verification and reach Level 3 to get a quota of %(verified_limit)s jobs."

msgid "Bạn đã dùng hết %(limit)s lượt đăng tin của tài khoản Cấp 3."
msgstr "You have used all %(limit)s job postings of your Level 3 account."

msgid "Tôi cam kết nội dung tin tuyển dụng là đúng sự thật, tuân thủ pháp luật và quy định đăng tin của ProCV, đồng thời chịu trách nhiệm về tin đã đăng và mọi chỉnh sửa sau đó."
msgstr "I confirm that the content of this job posting is truthful and complies with the law and ProCV's posting rules, and I take responsibility for the published posting and every later edit."

msgid "Hạn nhận hồ sơ phải từ hôm nay trở đi."
msgstr "The application deadline must be today or later."

msgid "Nhập tiêu đề tin tuyển dụng."
msgstr "Enter the job posting title."

msgid "Nhập mô tả công việc."
msgstr "Enter the job description."

msgid "Nhập yêu cầu ứng viên."
msgstr "Enter the candidate requirements."

msgid "Nhập quyền lợi ứng viên."
msgstr "Enter the candidate benefits."

msgid "Chọn cấp bậc."
msgstr "Select a level."

msgid "Chọn loại công việc."
msgstr "Select an employment type."

msgid "Chọn yêu cầu học vấn."
msgstr "Select an education requirement."

msgid "Chọn yêu cầu kinh nghiệm."
msgstr "Select an experience requirement."

msgid "Số lượng tuyển phải từ 1 trở lên."
msgstr "The number of openings must be at least 1."

msgid "Thêm ít nhất một địa điểm làm việc."
msgstr "Add at least one work location."

msgid "Chọn một vị trí chuyên môn chính."
msgstr "Select a primary specialization."

msgid "Nhập thông tin người nhận hồ sơ."
msgstr "Enter the application recipient details."

msgid "Hạn nhận hồ sơ không được quá %(days)s ngày kể từ hôm nay."
msgstr "The application deadline cannot be more than %(days)s days from today."

msgid "Nhập họ tên người nhận hồ sơ."
msgstr "Enter the full name of the application recipient."

msgid "Nhập số điện thoại người nhận hồ sơ."
msgstr "Enter the phone number of the application recipient."

msgid "Nhập ít nhất một email nhận hồ sơ."
msgstr "Enter at least one application email."

msgid "Tin đã hết vòng đời hiển thị. Cần một lượt đăng mới để tiếp tục."
msgstr "The posting's display lifetime has ended. A new posting is needed to continue."

msgid "Hạn nhận hồ sơ vượt thời gian công khai của tin. Vui lòng dùng quyền gia hạn tin trước."
msgstr "The application deadline goes beyond the posting's public period. Please extend the posting first."

msgid "Hạn gia hạn không được sau ngày kết thúc chiến dịch."
msgstr "The new deadline cannot be after the recruitment campaign's end date."

msgid "Chiến dịch hiện không hoạt động."
msgstr "The recruitment campaign is currently inactive."

msgid "Chưa thể đăng tin."
msgstr "The posting cannot be published yet."

msgid "Xác nhận cam kết chịu trách nhiệm về nội dung tin trước khi đăng."
msgstr "Confirm your responsibility commitment for the posting's content before publishing."

msgid "Tổng thời gian công khai của tin không được quá %(days)s ngày. Hãy nhân bản tin để đăng một lượt mới."
msgstr "A posting cannot be public for more than %(days)s days in total. Duplicate the posting to publish a new one."

msgid "Trạng thái kết luận không hợp lệ."
msgstr "Invalid resolution status."

msgid "Báo cáo này đã được xử lý."
msgstr "This report has already been handled."

msgid "Chỉ báo cáo đã xác nhận vi phạm mới có thể được gỡ."
msgstr "Only reports with a confirmed violation can be reverted."

msgid "Bạn đã báo cáo tin tuyển dụng này rồi."
msgstr "You have already reported this job posting."

msgid "Nhập lý do gỡ kết luận vi phạm."
msgstr "Enter the reason for reverting the violation decision."

