{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc",
    "import"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/exhaustive-deps": "error",
    "no-unused-vars": "error",
    "import/first": "error",
    "import/no-duplicates": "error",
    "import/no-self-import": "error",
    "import/no-cycle": "error",
    "max-lines": [
      "warn",
      {
        "max": 300,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "dayjs",
            "message": "Import dayjs từ '@/shared/lib/dayjs' để dùng đúng locale giao diện."
          }
        ],
        "patterns": [
          {
            "group": [
              "**/paraglide/*",
              "**/paraglide"
            ],
            "message": "Import m/getLocale từ '@/shared/config/i18n'; module đó khởi tạo locale trước khi dùng."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/*.test.js",
        "**/*.test.jsx",
        "tests/**"
      ],
      "rules": {
        "max-lines": "off"
      }
    },
    {
      "files": [
        "src/shared/lib/dayjs.js",
        "src/shared/config/i18n/index.js",
        "**/*.test.js",
        "**/*.test.jsx",
        "tests/**"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "ignorePatterns": [
    "src/shared/config/i18n/paraglide/**"
  ]
}
