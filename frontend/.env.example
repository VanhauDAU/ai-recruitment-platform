# ProCV frontend — mẫu cấu hình duy nhất. Sao chép thành frontend/.env:
#   cp .env.example .env
# Đồng bộ lại sau khi mẫu thay đổi (giữ nguyên giá trị đang có):
#   python3 ../scripts/sync_local_env.py
#
# Mọi biến VITE_* được bundle vào JavaScript công khai: KHÔNG đặt secret ở đây.
# Cờ CLI một lần (ANALYZE, PORT, PLAYWRIGHT_*) truyền qua process environment,
# xem docs/05-huong-dan/cau-hinh-env.md.

# ─────────────────────────────────────────────────────────────
# API và reCAPTCHA
# ─────────────────────────────────────────────────────────────
# Dev mặc định proxy /api tới API_PROXY_TARGET; production build bắt buộc có.
VITE_API_BASE_URL=/api
# Site key public (secret key nằm ở backend/.env).
VITE_RECAPTCHA_SITE_KEY=

# ─────────────────────────────────────────────────────────────
# Cổng subdomain — để trống ở dev (dùng path /tuyendung, /admin)
# ─────────────────────────────────────────────────────────────
VITE_MAIN_HOST=
VITE_EMPLOYER_HOST=
VITE_ADMIN_HOST=
# Domain cha cho marker logout giữa subdomain; trống -> suy ra từ các host trên.
VITE_AUTH_SYNC_COOKIE_DOMAIN=

# ─────────────────────────────────────────────────────────────
# Branding và asset — fallback khi site-settings API chưa trả về
# ─────────────────────────────────────────────────────────────
VITE_SITE_LOGO_URL=
VITE_SITE_LOGO_MARK_URL=
VITE_SITE_FAVICON_URL=
# Trống -> bucket dev mặc định trong src/shared/config/assets.js.
VITE_PUBLIC_ASSET_BASE_URL=

# ─────────────────────────────────────────────────────────────
# Consent và rollout
# ─────────────────────────────────────────────────────────────
VITE_COOKIE_CONSENT_ENABLED=true
# Trống/`none` giữ banner cũ; danh sách phân tách bằng dấu phẩy hoặc `all`.
VITE_ANNOUNCEMENT_ROLLOUT_SURFACES=

# ─────────────────────────────────────────────────────────────
# Vite dev server (không bundle vào ứng dụng)
# ─────────────────────────────────────────────────────────────
API_PROXY_TARGET=http://127.0.0.1:8000
