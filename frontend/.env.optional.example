# Catalog public và tooling tùy chọn. File này KHÔNG được Vite tự nạp; chỉ sao
# chép từng biến cần dùng vào .env.local hoặc process environment. vite.config.js
# gọi loadEnv để các biến tooling không có tiền tố VITE_ vẫn có hiệu lực.

# Fallback branding khi site-settings API chưa trả về (đường dẫn tương đối trong
# public/ hoặc URL tuyệt đối). Để trống -> dùng default trong entities/site-settings.
VITE_SITE_LOGO_URL=
VITE_SITE_LOGO_MARK_URL=
VITE_SITE_FAVICON_URL=

# Base URL cho asset tĩnh công khai (Cloudflare R2). Để trống -> dùng bucket dev
# mặc định trong src/shared/config/assets.js. Đổi khi tách bucket theo môi trường.
VITE_PUBLIC_ASSET_BASE_URL=
# Cookie consent bật mặc định.
VITE_COOKIE_CONSENT_ENABLED=true

# Rollout dải thông báo đa cổng. Để trống/`none` giữ banner cũ; dùng danh sách
# phân tách bằng dấu phẩy hoặc `all` khi surface đã qua smoke test.
VITE_ANNOUNCEMENT_ROLLOUT_SURFACES=

# Cổng subdomain (để trống ở dev — dùng path prefix /tuyendung, /admin)
VITE_MAIN_HOST=
VITE_EMPLOYER_HOST=
VITE_ADMIN_HOST=
# Tuỳ chọn: domain cha dùng cho marker logout giữa các subdomain. Khi bỏ trống,
# frontend tự suy ra từ các host trên (ví dụ `procv.vn`).
VITE_AUTH_SYNC_COOKIE_DOMAIN=

# Tooling Node/Vite; không được đổi thành VITE_* vì không phải dữ liệu public
# được bundle vào ứng dụng.
API_PROXY_TARGET=http://127.0.0.1:8000
PORT=5173
PLAYWRIGHT_PORT=5173
# Đặt 1 để sinh treemap HTML, hoặc json để sinh dist/stats.json.
ANALYZE=
