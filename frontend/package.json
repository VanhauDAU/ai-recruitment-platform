{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:mascot-assets": "node scripts/build-mascot-assets.mjs",
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint && node scripts/check-i18n.mjs",
    "lint:fix": "oxlint --fix",
    "check:architecture": "depcruise src --config .dependency-cruiser.cjs && node scripts/check-architecture-rules.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:related": "vitest related --run",
    "test:changed": "vitest run --changed origin/dev",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/smoke",
    "test:e2e:ui": "playwright test --ui",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/lora": "5.3.0",
    "@fontsource/roboto": "5.3.0",
    "@sentry/browser": "11.16.0",
    "@tanstack/react-query": "^5.108.2",
    "@tiptap/extension-character-count": "^3.35.0",
    "@tiptap/extension-image": "^3.35.0",
    "@tiptap/extension-table": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "antd": "^6.7.1",
    "axios": "^1.21.1",
    "dayjs": "^1.11.23",
    "dompurify": "^3.5.0",
    "html-to-image": "^1.11.13",
    "maplibre-gl": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-easy-crop": "6.2.5",
    "react-google-recaptcha-v3": "^1.11.0",
    "react-router": "8.5.2",
    "recharts": "^3.11.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.29.3",
    "@inlang/plugin-message-format": "4.6.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dependency-cruiser": "^17.4.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.94.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
