# Tùy chọn Docker Compose ở root. Sao chép thành .env khi cần override.
# Secret ứng dụng thuộc backend/.env; VITE_* thuộc frontend/.env.local.

# Bật profile theo nhu cầu, ví dụ scanner. Để trống để chỉ chạy core services.
COMPOSE_PROFILES=

# Image và giới hạn process local
BACKEND_IMAGE=ai-recruitment-platform-backend
BACKEND_PIDS_LIMIT=256
WORKER_PIDS_LIMIT=256
AI_WORKER_PIDS_LIMIT=128
BEAT_PIDS_LIMIT=64
FRONTEND_PIDS_LIMIT=256

# Celery local
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_MAX_TASKS_PER_CHILD=200
AI_WORKER_MAX_TASKS_PER_CHILD=100

# Scanner và log local
CLAMAV_PLATFORM=linux/amd64
CLAMD_STARTUP_TIMEOUT=900
FRESHCLAM_CHECKS=12
CLAMAV_MEMORY_LIMIT=4g
CLAMAV_CPU_LIMIT=2
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILES=3
