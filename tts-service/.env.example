TTS_ENVIRONMENT=development
TTS_INTERNAL_TOKEN=dev-tts-internal-token-change-me
TTS_CACHE_DIR=.cache/audio
TTS_CACHE_MAX_GB=5
TTS_CACHE_TTL_SECONDS=604800
TTS_SESSION_TTL_SECONDS=180
TTS_MAX_ACTIVE_SESSIONS=1000
TTS_MAX_TEXT_CHARS=30000
TTS_MAX_CONCURRENT_STREAMS=1
TTS_ONNX_THREADS=4
TTS_BACKEND=onnx
TTS_PRECISION=int8
TTS_MODEL_SOURCE=pnnbao-ump/VieNeu-TTS-v3-Turbo
TTS_MODEL_REVISION=vieneu-3.2.3-v3-turbo-int8
TTS_FFMPEG_BINARY=ffmpeg
